PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=talkto_persona_ai
DB_SSL=false
DB_SYNCHRONIZE=true
DB_MIGRATIONS_RUN=false

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

AI_SERVER_URL=https://persona-ai-ai.onrender.com
AI_SERVER_TOKEN=
AI_SERVER_TIMEOUT_MS=120000

MEMORY_IMPORT_SOURCE_URL=https://api.github.com/repos/MediLux-TalkTo/TalkTo_PersonaAI_AI/contents/data/backend_memory_import.json?ref=main
BACKEND_URL=http://localhost:3000
E2E_BASE_URL=
E2E_CHAT_SMOKE=false

AUDIO_STORAGE_DRIVER=local
LOCAL_AUDIO_STORAGE_DIR=storage/audio
LOCAL_AUDIO_PUBLIC_PATH=/audio
AUDIO_SIGNED_URL_TTL_SECONDS=3600
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

ADMIN_NAME=Local Admin
ADMIN_EMAIL=admin@talkto.local
ADMIN_PASSWORD=Admin1234!
BOOTSTRAP_SEED=true
